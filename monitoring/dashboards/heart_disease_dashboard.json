      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(heart_disease_predictions_total{outcome='no_disease'}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "title": "Request Throughput & Response Codes",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (status) (rate(http_requests_total[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
