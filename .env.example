# Copy this file to .env only for local configuration. Never commit .env.
# Values below are safe placeholders, not real credentials.

# Grafana local development login. Change these before exposing Grafana beyond localhost.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_PUBLIC_EXPOSURE

# Optional identity and repository values for `make report` / `./Make.ps1 report`.
REPORT_STUDENT_NAME=TO_BE_FILLED
REPORT_STUDENT_ID=TO_BE_FILLED
REPORT_STUDENT_EMAIL=TO_BE_FILLED
REPO_URL=https://github.com/Sainagasashank/heart-disease-mlops-pipeline
